    "@x402/hono": "2.30.0",
    "@x402/svm": "2.30.0",
    "hono": "4.13.16",
    "ox": "1.8.13",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@x402/fetch": "2.30.0",
    "tsx": "4.23.15",
