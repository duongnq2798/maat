# RPC for Base mainnet (archive not required for the agent itself).
BASE_RPC_URL=https://mainnet.base.org
# Optional second Base RPC, best from another provider: a request that fails on BASE_RPC_URL is sent here.
BASE_RPC_URL_FALLBACK=
# From the deploy logs (deployments/README.md).
MAAT_VAULT=0x0000000000000000000000000000000000000000
# The CDP Server Wallet account address; the vault owner must setExecutor() to it.
MAAT_EXECUTOR=0x0000000000000000000000000000000000000000
MAAT_EXPENSE_PAYEE=0x0000000000000000000000000000000000000000
# dry-run (default): read, ask Claude, preview, journal; never send. live: also send through CDP.
MAAT_MODE=dry-run
# Builder Code from base.dev (required in live mode).
MAAT_BUILDER_CODE=
MAAT_LOOP_MODEL=claude-sonnet-5-5
MAAT_DATA_DIR=./data
MAAT_MAX_TX_PER_DAY=40
MAAT_DEFAULT_DAILY_COMPUTE_USD=0.5
# off (default): never suggest, ask Claude for or send SUPPLY, WITHDRAW_COLLATERAL, BORROW or REPAY. on: allow them.
MAAT_CREDIT_ACTIONS=off
# US dollars of Claude usage per UTC day; once reached, the day's later rounds do not call Claude.
MAAT_MAX_LLM_USD_PER_DAY=0.75
# Smallest unpaid compute bill a round pays, in US dollars. Unset: 1.00 in live mode, 0.10 in dry-run.
MAAT_BILL_MIN_USD=
# Anthropic API key. The agent calls Claude only at https://api.anthropic.com, with this key.
ANTHROPIC_API_KEY=
# CDP Server Wallet (see agent/README.md)
CDP_ACCOUNT_NAME=maat-executor
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
