# Public RPC with archive state (tested on 2026-11-06). If you get a 429, use a free Alchemy/QuickNode key.
BASE_RPC_URL=https://mainnet.base.org
# Address of the wallet that signs the broadcast (the same wallet as --account). The script uses this wallet's nonce to precompute the vault address.
MAAT_DEPLOYER=0x0000000000000000000000000000000000000000
MAAT_OWNER=0x0000000000000000000000000000000000000000
MAAT_EXECUTOR=0x0000000000000000000000000000000000000000
MAAT_EXPENSE_PAYEE=0x0000000000000000000000000000000000000000
# Optional second expense payee, allowlisted at deploy (for example an agent's Bankr wallet). The zero address leaves it unset.
MAAT_EXPENSE_PAYEE_2=0x0000000000000000000000000000000000000000
